[
  {
    "name": "Install the kernel's build dependencies",
    "run": "sudo apt-get update -q\nsudo apt-get install -y -q --no-install-recommends bc bison flex libelf-dev libssl-dev",
    "shell": "bash",
    "phase": "prepare"
  },
  {
    "name": "Configure x86_64_defconfig",
    "run": "make ARCH=x86_64 x86_64_defconfig",
    "shell": "bash",
    "phase": "build",
    "env": {
      "KBUILD_BUILD_HOST": "abis",
      "KBUILD_BUILD_USER": "abis",
      "KBUILD_BUILD_TIMESTAMP": "1970-01-01 00:00:00 UTC"
    }
  },
  {
    "name": "Build vmlinux",
    "run": "make ARCH=x86_64 -j\"$(nproc)\" vmlinux",
    "shell": "bash",
    "phase": "build",
    "env": {
      "KBUILD_BUILD_HOST": "abis",
      "KBUILD_BUILD_USER": "abis",
      "KBUILD_BUILD_TIMESTAMP": "1970-01-01 00:00:00 UTC"
    }
  }
]
